@media (max-width: 960px) {
  /* For a screen < 960px, this CSS will be read */
  .container {
    width: 700px;
  }
}

@media (max-width: 720px) {
  /* For a screen < 720px, this CSS will be read */
  .container {
    width: 500px;
  }
}

@media (max-width: 540px) {
  /* For a screen < 540px, this CSS will be read */
  .container {
    width: 300px;
  }
}

body {
  font-family: Times, serif;
  font-size: 20px;
  line-height: 20px;
  color: #090123;
  background-color: rgb(1, 151, 177);
}

.card-white {
  background: rgb(255, 255, 255);                         /* White background */
  padding: 30px;                             /* Internal space */
  border-radius: 4px;                        /* Small radius */
  box-shadow: 0 10px 30px rgba(0,0,0,.1);    /* Light shadow */
  width: 700px;
  margin: 20px auto;
  text-align: center;
}

h1 {
  font-family: Times, serif;
  font-size: 25px;
  font-weight: 900;
  line-height: 20px;
  color: #090123;
}

#avatar {
  width: 100px;
  border-radius: 50%;
}

#introduction {
  margin-bottom: 40px;
}

#btn-blue {
  background-color: #0f4dd2;
  padding: 15px 20px;
  color: white;
  text-decoration: none;
  font-weight: 800;
  border-radius: 4px;
  margin: 40px;
}

#btn-blue:hover {
  background-color: rgb(1, 27, 6);
}

h2 {
  font-family: Times, serif;
  font-size: 25px;
  color: #7ECE90;
  line-height: 15px;
  color: #230101ce;
}

.social-links a {
  color: lightgrey;
  font-size: 40px;
}

.social-links a:hover {
  color: black;
}

.visually-hidden {
  display: none;
}
